# Document Processor — production environment template
# Copy to `.env.production` and fill in real secrets before deploying:
#   cp .env.production.example .env.production
#
# Never commit `.env.production` — it holds live credentials.

# --- PostgreSQL (POSTGRES_* seed the postgres container; keep POSTGRES_PASSWORD
#     in sync with the password embedded in DATABASE_URL) ---
DATABASE_URL=postgresql+asyncpg://docproc:CHANGE_ME@postgres:5432/docproc
POSTGRES_DB=docproc
POSTGRES_USER=docproc
POSTGRES_PASSWORD=CHANGE_ME

# --- MinIO (S3-compatible object storage) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=documents
MINIO_SECURE=false
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME

# --- OCR ---
OCR_PRIMARY_ENGINE=paddle
OCR_FALLBACK_ENGINE=easyocr
OCR_CONFIDENCE_THRESHOLD=0.7

# --- Auth (JWT) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# --- Ingress limits / quotas ---
RATE_LIMIT_PER_MINUTE=60
DAILY_DOCUMENT_CAP=100
MAX_IMAGE_SIZE_BYTES=10485760

# --- Storage lifecycle ---
STORAGE_QUOTA_BYTES=10737418240
STORAGE_HIGH_WATERMARK_PCT=85
STORAGE_CRITICAL_PCT=95
STORAGE_EXPIRE_COMPLETED_DAYS=90
STORAGE_EXPIRE_CRITICAL_DAYS=30

# --- CORS (JSON array; production SPA origin(s) only) ---
CORS_ALLOW_ORIGINS=["https://app.example.com"]
