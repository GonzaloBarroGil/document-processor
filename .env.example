# Document Processor — environment template
# Copy to `.env` and adjust for your environment:
#   cp .env.example .env
#
# Hostnames below match the docker-compose service names (postgres, minio).
# For a non-Docker local run, change them to localhost.

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://docproc:docproc@postgres:5432/docproc

# --- MinIO (S3-compatible object storage) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
MINIO_SECURE=false

# --- OCR ---
OCR_PRIMARY_ENGINE=paddle
OCR_FALLBACK_ENGINE=easyocr
OCR_CONFIDENCE_THRESHOLD=0.7

# --- Auth (JWT) ---
# Set a long random secret in production: `python -c "import secrets; print(secrets.token_urlsafe(64))"`
JWT_SECRET=dev-only-jwt-secret-please-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# --- Ingress limits / quotas ---
RATE_LIMIT_PER_MINUTE=60
DAILY_DOCUMENT_CAP=100
MAX_IMAGE_SIZE_BYTES=10485760

# --- Storage lifecycle ---
STORAGE_QUOTA_BYTES=10737418240
STORAGE_HIGH_WATERMARK_PCT=85
STORAGE_CRITICAL_PCT=95
STORAGE_EXPIRE_COMPLETED_DAYS=90
STORAGE_EXPIRE_CRITICAL_DAYS=30

# --- CORS (JSON array; local dev origins shown) ---
CORS_ALLOW_ORIGINS=["http://localhost:5173","http://localhost:4173","http://localhost:3000"]
